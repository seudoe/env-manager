# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# MongoDB connection string.
MONGODB_URI=mongodb://localhost:27017/env-manager

# Required. Used to sign session JWTs and to derive the AES-256-GCM key that
# encrypts project data at rest. Must be at least 32 characters — the app
# will refuse to start without a valid value (no fallback default).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=

# Base URL this app is served from (used in a few client-facing links).
NEXT_PUBLIC_APP_URL=http://localhost:3000
